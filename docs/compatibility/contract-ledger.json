      "live_status": "unverified"
    },
    {
      "id": "4.1.1-moving-state",
      "scope": "torrent serialization",
      "status": "source-reviewed-partial",
      "findings": "4.1.1 adds explicit Moving -> moving serialization case absent in 4.1.0. Backend state availability and fallback need review.",
